#!/bin/bash
# Launch script for the EasyRPG Player runtime (RPG Maker 2000/2003, GPLv3,
# software-rendered). The runtime squashfs bundles easyrpg-player + its private
# libs + EasyRPG's FREE RTP replacement; SDL2 comes from the device (the same
# lib mkxp-z already uses). EasyRPG reads the game from its working dir, so we
# just cd into the port and run the binary straight from the read-only mount —
# no copy-out needed (unlike falcon).
#
# NOTE: exact binary name / RTP env vars / mount layout are finalized against the
# built runtime squashfs (see the runtime recipe); adjust EASYRPG_BIN and the
# RPG*_RTP_PATH exports if the packaging differs.
XDG_DATA_HOME=${XDG_DATA_HOME:-$HOME/.local/share}
if [ -d "/opt/system/Tools/PortMaster/" ]; then controlfolder="/opt/system/Tools/PortMaster"
elif [ -d "/opt/tools/PortMaster/" ]; then controlfolder="/opt/tools/PortMaster"
elif [ -d "$XDG_DATA_HOME/PortMaster/" ]; then controlfolder="$XDG_DATA_HOME/PortMaster"
else controlfolder="/roms/ports/PortMaster"; fi
source $controlfolder/control.txt
[ -f "${controlfolder}/mod_${CFW_NAME}.txt" ] && source "${controlfolder}/mod_${CFW_NAME}.txt"
get_controls
GAMEDIR="/$directory/ports/@SLUG@"
EASYRPG_RUNTIME="$controlfolder/libs/easyrpg.squashfs"
EASYRPG="$HOME/easyrpg"
EASYRPG_BIN="$EASYRPG/easyrpg-player"
cd "$GAMEDIR" || exit 1
> "$GAMEDIR/log.txt" && exec > >(tee "$GAMEDIR/log.txt") 2>&1
# A force-quit skips normal cleanup, leaking the squashfs mount and hanging the
# next launch. Trap the graceful exit, and clear any leaked mount before mounting.
pf_cleanup() {
    $ESUDO umount "$EASYRPG" 2>/dev/null || $ESUDO umount -l "$EASYRPG" 2>/dev/null
    [ -n "$SWAP" ] && $ESUDO swapoff "$SWAP" 2>/dev/null
}
trap pf_cleanup EXIT INT TERM
if [ -f "$EASYRPG_RUNTIME" ]; then
    $ESUDO mkdir -p "$EASYRPG"
    $ESUDO umount "$EASYRPG" 2>/dev/null || $ESUDO umount -l "$EASYRPG" 2>/dev/null || true
    $ESUDO mount "$EASYRPG_RUNTIME" "$EASYRPG"
else
    pm_message "easyrpg runtime missing."; sleep 5; pm_finish; exit 1
fi
mkdir -p "$GAMEDIR/config"
export SDL_GAMECONTROLLERCONFIG="$sdl_controllerconfig"
export XDG_CONFIG_HOME="$GAMEDIR/config"
export XDG_DATA_HOME="$GAMEDIR/config"
export LC_ALL=C
export LANG=C
# EasyRPG's free RTP replacement, bundled in the runtime — point the RM2k/2k3
# RTP env vars at it so RTP-dependent games find shared assets.
export RPG_RTP_PATH="$EASYRPG/rtp"
export RPG2K_RTP_PATH="$EASYRPG/rtp/2000"
export RPG2K3_RTP_PATH="$EASYRPG/rtp/2003"
# Some games OOM the engine on low-RAM handhelds without swap. Share one 2GB
# swapfile across all Port Forge games on a writable non-FAT partition.
SWAP=""
for d in /mnt/UDISK /userdata /storage /mnt/mmc /roms2; do
    { [ -d "$d" ] && touch "$d/.pfsw" 2>/dev/null; } || continue
    rm -f "$d/.pfsw"
    cand="$d/portforge.swap"
    if [ ! -f "$cand" ]; then
        $ESUDO dd if=/dev/zero of="$cand" bs=1M count=2048 2>/dev/null
        $ESUDO chmod 600 "$cand"
        $ESUDO mkswap "$cand" >/dev/null 2>&1 || { $ESUDO rm -f "$cand"; continue; }
    fi
    $ESUDO swapon "$cand" 2>/dev/null && { SWAP="$cand"; break; }
done
$GPTOKEYB "easyrpg-player" -c "$GAMEDIR/@SLUG@.gptk" &
export LD_LIBRARY_PATH="$EASYRPG/libs:$LD_LIBRARY_PATH"
pm_platform_helper "$EASYRPG_BIN" >/dev/null
# EasyRPG reads the game from --project-path (or cwd); --fullscreen fills the panel.
"$EASYRPG_BIN" --fullscreen --project-path "$GAMEDIR"
pf_cleanup
pm_finish
