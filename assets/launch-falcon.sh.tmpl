#!/bin/bash
# Launch script for the falcon-mkxp (classic RGSS, Ruby 2.7) runtime. The engine
# reads mkxp.conf from the game dir (cwd); the runtime squashfs bundles the
# binary + its private libs, and the SDL2/OpenAL/pixman/vorbisfile stack comes
# from the device (the same libs mkxp-z already uses). No Ruby stdlib dir and no
# compat loader — falcon's own Ruby-1.8 preloads are built into the binary.
XDG_DATA_HOME=${XDG_DATA_HOME:-$HOME/.local/share}
if [ -d "/opt/system/Tools/PortMaster/" ]; then controlfolder="/opt/system/Tools/PortMaster"
elif [ -d "/opt/tools/PortMaster/" ]; then controlfolder="/opt/tools/PortMaster"
elif [ -d "$XDG_DATA_HOME/PortMaster/" ]; then controlfolder="$XDG_DATA_HOME/PortMaster"
else controlfolder="/roms/ports/PortMaster"; fi
source $controlfolder/control.txt
[ -f "${controlfolder}/mod_${CFW_NAME}.txt" ] && source "${controlfolder}/mod_${CFW_NAME}.txt"
get_controls
GAMEDIR="/$directory/ports/@SLUG@"
FALCON_RUNTIME="$controlfolder/libs/falcon-mkxp.squashfs"
FALCON="$HOME/falcon-mkxp"
cd "$GAMEDIR" || exit 1
> "$GAMEDIR/log.txt" && exec > >(tee "$GAMEDIR/log.txt") 2>&1
# A force-quit skips normal cleanup, leaking the squashfs mount and hanging the
# next launch. Trap the graceful exit, and clear any leaked mount before mounting.
pf_cleanup() {
    $ESUDO umount "$FALCON" 2>/dev/null || $ESUDO umount -l "$FALCON" 2>/dev/null
    [ -n "$SWAP" ] && $ESUDO swapoff "$SWAP" 2>/dev/null
}
trap pf_cleanup EXIT INT TERM
if [ -f "$FALCON_RUNTIME" ]; then
    $ESUDO mkdir -p "$FALCON"
    $ESUDO umount "$FALCON" 2>/dev/null || $ESUDO umount -l "$FALCON" 2>/dev/null || true
    $ESUDO mount "$FALCON_RUNTIME" "$FALCON"
else
    pm_message "falcon-mkxp runtime missing."; sleep 5; pm_finish; exit 1
fi
mkdir -p "$GAMEDIR/config"
# falcon-mkxp finds Game.ini/Data next to its OWN binary, not the cwd — so run
# it FROM the game dir (copy it out of the read-only squashfs, like the classic
# PortMaster RMXP ports do). libs still come from the mounted squashfs.
cp -f "$FALCON/falcon_mkxp.bin" "$GAMEDIR/falcon_mkxp.bin"
$ESUDO chmod +x "$GAMEDIR/falcon_mkxp.bin" 2>/dev/null
# falcon's own Win32API/Ruby-1.8 preload scripts live in the runtime; copy them
# next to the game so mkxp.conf's relative preloadScript path resolves. (COPY,
# not symlink — the SD card is FAT and doesn't support symlinks. It's tiny.)
cp -rf "$FALCON/Falcon_preload" "$GAMEDIR/Falcon_preload"
export SDL_GAMECONTROLLERCONFIG="$sdl_controllerconfig"
export XDG_CONFIG_HOME="$GAMEDIR/config"
export XDG_DATA_HOME="$GAMEDIR/config"
export LC_ALL=C
export LANG=C
# Some RGSS games OOM-kill the engine on low-RAM handhelds without swap. Share
# one 2GB swapfile across all Port Forge games on a writable non-FAT partition.
SWAP=""
for d in /mnt/UDISK /userdata /storage /mnt/mmc /roms2; do
    { [ -d "$d" ] && touch "$d/.pfsw" 2>/dev/null; } || continue
    rm -f "$d/.pfsw"
    cand="$d/portforge.swap"
    if [ ! -f "$cand" ]; then
        $ESUDO dd if=/dev/zero of="$cand" bs=1M count=2048 2>/dev/null
        $ESUDO chmod 600 "$cand"
        $ESUDO mkswap "$cand" >/dev/null 2>&1 || { $ESUDO rm -f "$cand"; continue; }
    fi
    $ESUDO swapon "$cand" 2>/dev/null && { SWAP="$cand"; break; }
done
$GPTOKEYB "falcon_mkxp.bin" -c "$GAMEDIR/@SLUG@.gptk" &
export LD_LIBRARY_PATH="$FALCON/libs:$LD_LIBRARY_PATH"
export SRCDIR="$GAMEDIR"
pm_platform_helper "$GAMEDIR/falcon_mkxp.bin" >/dev/null
"$GAMEDIR/falcon_mkxp.bin"
pf_cleanup
pm_finish
